    "app/src/main/java/com/dogeos/launcher/MainActivity.java": r"""
package com.dogeos.launcher;

import android.app.Activity;
import android.os.Bundle;
import android.content.Intent;
import android.content.pm.ResolveInfo;
import android.content.pm.PackageManager;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.view.Gravity;
import android.widget.*;
import android.text.*;
import java.util.*;

public class MainActivity extends Activity {
    final int BLACK = Color.rgb(17,17,17);
    final int YELLOW = Color.rgb(255,204,0);
    final int WHITE = Color.WHITE;
    final int GRAY = Color.LTGRAY;
    LinearLayout grid;
    EditText search;
    List<ResolveInfo> apps = new ArrayList<>();

    int dp(int n) {
        return (int)(n * getResources().getDisplayMetrics().density + .5f);
    }

    GradientDrawable bg(int color, int radius) {
        GradientDrawable d = new GradientDrawable();
        d.setColor(color);
        d.setCornerRadius(dp(radius));
        return d;
    }

    @Override
    public void onCreate(Bundle b) {
        super.onCreate(b);
        getWindow().setStatusBarColor(BLACK);
        getWindow().setNavigationBarColor(BLACK);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(1);
        root.setPadding(dp(18),dp(16),dp(18),dp(8));
        root.setBackgroundColor(BLACK);

        TextView title = new TextView(this);
        title.setText("Ð  DOGE OS");
        title.setTextColor(YELLOW);
        title.setTextSize(30);
        title.setTypeface(null,Typeface.BOLD);
        root.addView(title);

        TextView slogan = new TextView(this);
        slogan.setText("MUCH SIMPLE. VERY FAST. WOW.");
        slogan.setTextColor(GRAY);
        slogan.setPadding(0,dp(4),0,dp(16));
        root.addView(slogan);

        Button settings = new Button(this);
        settings.setText("SYSTEM SETTINGS");
        settings.setTextColor(BLACK);
        settings.setBackgroundColor(YELLOW);
        root.addView(settings,new LinearLayout.LayoutParams(-1,dp(48)));
        settings.setOnClickListener(v -> {
            try {
                startActivity(new Intent(android.provider.Settings.ACTION_SETTINGS));
            } catch(Exception ignored) {}
        });

        search = new EditText(this);
        search.setSingleLine(true);
        search.setTextColor(WHITE);
        search.setHintTextColor(GRAY);
        search.setHint("Search apps...");
        search.setBackground(bg(Color.DKGRAY,12));
        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(-1,dp(48));
        sp.setMargins(0,dp(12),0,dp(12));
        root.addView(search,sp);

        TextView heading = new TextView(this);
        heading.setText("YOUR APPS");
        heading.setTextColor(YELLOW);
        heading.setTypeface(null,Typeface.BOLD);
        root.addView(heading);

        ScrollView scroll = new ScrollView(this);
        grid = new LinearLayout(this);
        grid.setOrientation(1);
        scroll.addView(grid);
        root.addView(scroll,new LinearLayout.LayoutParams(-1,0,1));

        TextView footer = new TextView(this);
        footer.setText("DOGE OS 1.0 • FREE EDITION");
        footer.setTextColor(GRAY);
        footer.setGravity(Gravity.CENTER);
        footer.setPadding(0,dp(12),0,dp(8));
        root.addView(footer);

        setContentView(root);
        loadApps();
        showApps("");

        search.addTextChangedListener(new TextWatcher() {
            public void beforeTextChanged(CharSequence s,int st,int c,int a) {}
            public void onTextChanged(CharSequence s,int st,int before,int count) {
                showApps(s.toString());
            }
            public void afterTextChanged(Editable e) {}
        });
    }

    void loadApps() {
        Intent i = new Intent(Intent.ACTION_MAIN);
        i.addCategory(Intent.CATEGORY_LAUNCHER);
        apps = getPackageManager().queryIntentActivities(i,0);
        Collections.sort(apps,(a,b) ->
            a.loadLabel(getPackageManager()).toString().compareToIgnoreCase(
                b.loadLabel(getPackageManager()).toString()));
    }

    void showApps(String filter) {
        grid.removeAllViews();
        LinearLayout row = null;
        int count = 0;
        PackageManager pm = getPackageManager();

        for (ResolveInfo app : apps) {
            String name = app.loadLabel(pm).toString();
            if (!name.toLowerCase(Locale.ROOT).contains(
                    filter.toLowerCase(Locale.ROOT))) continue;

            if (count % 3 == 0) {
                row = new LinearLayout(this);
                row.setGravity(Gravity.TOP);
                grid.addView(row,new LinearLayout.LayoutParams(-1,-2));
            }

            LinearLayout tile = new LinearLayout(this);
            tile.setOrientation(1);
            tile.setGravity(Gravity.CENTER);
            tile.setPadding(dp(4),dp(12),dp(4),dp(12));
            tile.setBackground(bg(Color.rgb(31,31,31),14));

            ImageView icon = new ImageView(this);
            try { icon.setImageDrawable(app.loadIcon(pm)); }
            catch(Exception ignored) {}
            tile.addView(icon,new LinearLayout.LayoutParams(dp(48),dp(48)));

            TextView label = new TextView(this);
            label.setText(name);
            label.setTextColor(WHITE);
            label.setGravity(Gravity.CENTER);
            label.setTextSize(12);
            label.setMaxLines(2);
            tile.addView(label);

            LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(0,-2,1);
            tp.setMargins(dp(4),dp(4),dp(4),dp(4));
            row.addView(tile,tp);

            tile.setOnClickListener(v -> {
                Intent launch = new Intent(Intent.ACTION_MAIN);
                launch.addCategory(Intent.CATEGORY_LAUNCHER);
                launch.setClassName(app.activityInfo.packageName,
                                    app.activityInfo.name);
                try { startActivity(launch); }
                catch(Exception ignored) {}
            });
            count++;
        }

        if (count == 0) {
            TextView empty = new TextView(this);
            empty.setText("No apps found.");
            empty.setTextColor(GRAY);
            grid.addView(empty);
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (grid != null) {
            loadApps();
            showApps(search == null ? "" : search.getText().toString());
        }
    }
}
